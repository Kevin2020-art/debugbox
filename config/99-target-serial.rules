# ==============================================================================
# DebugBox 多串口固化 UDEV 规则 (固定映射为 /dev/target_uart1 ~ target_uart4)
#
# 作用：
#   解决多个 USB-TTL 串口小板因系统重启或热插拔导致的“设备名漂移”问题。
#   支持以下三种绑定方式：
#     1. 物理插槽绑定（树莓派 4B 4个物理 USB 口）
#     2. 多通道串口芯片绑定 (FT4232H / CH344 多通道自动映射)
#     3. 单串口向下兼容兜底 (/dev/target_uart)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 树莓派 4B 物理 USB 孔位精准绑定 (USB 2.0 / USB 3.0 接口)
# ------------------------------------------------------------------------------
# 端口 1 (USB 2.0 上口 / 物理总线 1-1.1):
ACTION=="add", SUBSYSTEM=="tty", KERNELS=="1-1.1*", SYMLINK+="target_uart1 target_uart", MODE="0666"

# 端口 2 (USB 2.0 下口 / 物理总线 1-1.2):
ACTION=="add", SUBSYSTEM=="tty", KERNELS=="1-1.2*", SYMLINK+="target_uart2", MODE="0666"

# 端口 3 (USB 3.0 上口 / 物理总线 1-1.3):
ACTION=="add", SUBSYSTEM=="tty", KERNELS=="1-1.3*", SYMLINK+="target_uart3", MODE="0666"

# 端口 4 (USB 3.0 下口 / 物理总线 1-1.4):
ACTION=="add", SUBSYSTEM=="tty", KERNELS=="1-1.4*", SYMLINK+="target_uart4", MODE="0666"

# ------------------------------------------------------------------------------
# 2. 多合一 USB 串口芯片按通道号绑定 (如 FT4232H, FT2232D, CH344 等四合一芯片)
# ------------------------------------------------------------------------------
ACTION=="add", SUBSYSTEM=="tty", ENV{ID_USB_INTERFACE_NUM}=="00", SYMLINK+="target_uart1 target_uart", MODE="0666"
ACTION=="add", SUBSYSTEM=="tty", ENV{ID_USB_INTERFACE_NUM}=="01", SYMLINK+="target_uart2", MODE="0666"
ACTION=="add", SUBSYSTEM=="tty", ENV{ID_USB_INTERFACE_NUM}=="02", SYMLINK+="target_uart3", MODE="0666"
ACTION=="add", SUBSYSTEM=="tty", ENV{ID_USB_INTERFACE_NUM}=="03", SYMLINK+="target_uart4", MODE="0666"

# ------------------------------------------------------------------------------
# 3. 通用兜底规则 (单串口模式向下完全兼容)
# ------------------------------------------------------------------------------
ACTION=="add", SUBSYSTEM=="tty", KERNEL=="ttyUSB*", SYMLINK+="target_uart", MODE="0666"
ACTION=="add", SUBSYSTEM=="tty", KERNEL=="ttyACM*", SYMLINK+="target_uart", MODE="0666"
